{
  "name": "commits-site",
  "version": "1.0.0",
  "description": "Landing page and dashboard for commits.site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test src/app scripts",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "generate:test-fixture": "bun scripts/generate-test-fixture.ts",
    "format": "bunx prettier --write .",
    "deploy": "bun run build && vercel --prod",
    "deploy:preview": "bun run build && vercel"
  },
  "keywords": [
    "github",
    "contributions",
    "dashboard",
    "heatmap"
  ],
  "author": "Helge Sverre",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "alpinejs": "^3.15.12",
    "flatpickr": "^4.6.13",
    "lucide": "^1.30.0"
  }
}
